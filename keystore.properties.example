# Образец. Скопируйте в keystore.properties (рядом с этим файлом) и впишите свои значения.
# keystore.properties в репозиторий не попадает (.gitignore), сам ключ лучше держать вне папки проекта.
# Путь — с прямыми косыми чертами, даже в Windows.
storeFile=D:/AnyProject/VK/keys/vkweb.jks
storePassword=пароль_хранилища
keyAlias=key0
keyPassword=пароль_ключа
