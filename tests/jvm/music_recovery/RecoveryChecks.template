// Controlled boundaries for the actual cache() method and Job observer implementation.
class Scheduler : Executor {
    private val tasks = ArrayDeque<Runnable>()
    override fun execute(command: Runnable) { tasks.addLast(command) }
    fun post(run: () -> Unit) { tasks.addLast(Runnable(run)) }
    fun drain() { repeat(100) { if (tasks.isEmpty()) return; tasks.removeFirst().run() }; error("unbounded scheduling") }
}
object MusicCache {
    var generation = 1L
    val stored = HashSet<String>()
    fun currentGeneration() = generation
    fun isCached(id: String) = id in stored
}
object MusicCacheService { fun ensureRunning(app: Any) {} }
object MusicDownloadStarter {
    var onFinish: ((MusicDownload) -> Unit)? = null
    var cancellation = 0L
    fun cancellationGeneration() = cancellation
    fun recoveryIsCurrent(cache: Long, cancel: Long) = MusicRecovery.isCurrent(cache, cancel, MusicCache.generation, cancellation)
    fun finishRecovery(download: MusicDownload, failed: Boolean = false) { onFinish?.invoke(download) }
}
object MusicCacheWorker {
    data class Request(val download: MusicDownload, val batch: CacheBatch?)
    var pending = 0
    val requests = ArrayList<Request>()
    var beforeRecover: (() -> Unit)? = null
    fun recover(app: Any, download: MusicDownload, batch: CacheBatch?) {
        beforeRecover?.invoke(); pending++; requests += Request(download, batch)
    }
}
