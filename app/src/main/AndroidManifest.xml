<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Только Android 8–9 и только для переноса кэша музыки 4.97–4.98 из «Музыка/VkWebLite» в папку приложения
         (4.99): приложение его больше не спрашивает; разрешение, данное раньше, сохраняется при обновлении. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Знать, есть ли сеть: без неё показываются сохранённые данные. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Кэширование списка музыки в фоне (media/MusicCacheService.kt, 4.98). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Музыка при выключенном экране: процессор и Wi-Fi удерживаются только пока она звучит (media/MusicService.kt). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Система запускает задания планировщика после перезагрузки: проверка сообщений не пропадает. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 4.17: отложенная отправка точно ко времени (Android 12+ — с разрешения человека; без него — неточно). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Прямой запрос «не ограничивать батарею» для этого приложения: без него уведомления о сообщениях опаздывают
         на часы (система откладывает фоновую проверку). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Голосовые сообщения и видеозвонки на сайте VK -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Резервные копии и перенос на новый телефон (4.28): allowBackup — до Android 11 (ничего); с Android 12 —
         правила xml/data_extraction_rules.xml (в облако ничего, при переносе — только настройки, без входа в VK). -->
    <application
        android:name=".VkWebApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VkWeb.Dark"
        android:usesCleartextTraffic="false"
        tools:ignore="DataExtractionRules"
        tools:targetApi="33">

        <!-- AppCompat при запуске ищет этот сервис (хранение языка приложения). Без объявления он бросает
             и сам же ловит NameNotFoundException — безвредно, но отладчик останавливается на нём. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="false" />
        </service>

        <!-- Не отправлять Google статистику использования WebView. -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />

        <!-- configChanges: WebView живёт в Activity, пересоздание оборвало бы музыку и сбросило страницу.
             screenOrientation="fullUser" (3.89) у всех экранов: поворот — по настройке Android (автоповорот или
             блокировка, в том числе кнопка поворота на панели навигации при заблокированном). -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Ярлыки на значке (недавние переписки и разделы) с 4.57 публикуются из кода: ui/AppShortcuts.kt. -->
        </activity>

        <!-- Ярлыки на значке приложения (3.94): не экспортирована — запускает только лаунчер от имени приложения. -->
        <activity
            android:name=".web.ShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Ссылки VK из других приложений (3.94): прозрачная прослойка без окна. Открывает ссылку в задаче приложения,
             а не в задаче браузера: иначе там появилось бы второе главное окно со своей страницей и музыкой. -->
        <activity
            android:name=".web.LinkActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <!-- Домен VK подтвердить нельзя, поэтому Android 12+ по умолчанию открывает такие ссылки в браузере:
                 пользователь включает их сам («Открывать по умолчанию»; пункт есть в настройках «Навигация»).
                 Путь проверяет web/VkLinks.kt. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="vk.com" />
                <data android:host="m.vk.com" />
                <data android:host="www.vk.com" />
                <data android:host="vk.ru" />
                <data android:host="m.vk.ru" />
                <data android:host="www.vk.ru" />
            </intent-filter>
        </activity>

        <!-- «Поделиться» из других приложений (4.57): прозрачная прослойка, проверяет присланное и передаёт его экрану
             сообщений (тот не экспортирован). -->
        <activity
            android:name=".messages.ShareReceiverActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_target_label"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".messages.MessagesActivity"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:exported="false"
            android:label="@string/tab_messages"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".crash.CrashReportActivity"
            android:screenOrientation="fullUser"
            android:exported="false"
            android:label="@string/crash_title" />

        <activity
            android:name=".ui.PhotoViewerActivity"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:label="@string/photo_description"
            android:theme="@style/Theme.VkWeb.PhotoViewer" />

        <!-- Видео и клипы из переписки; поворот не пересоздаёт экран, чтобы видео не начиналось заново. -->
        <activity
            android:name=".ui.VideoPlayerActivity"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:label="@string/video_player_description"
            android:theme="@style/Theme.VkWeb.Dark" />

        <!-- Свой проигрыватель ленты клипов (clips/ClipsActivity.kt); поворот не пересоздаёт экран. -->
        <activity
            android:name=".clips.ClipsActivity"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:label="@string/clips_video_description"
            android:theme="@style/Theme.VkWeb.Dark" />

        <activity
            android:name=".settings.SettingsActivity"
            android:screenOrientation="fullUser"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity" />

        <!-- Папка приложения в системном приложении «Файлы» (files/AppFilesProvider.kt, 4.99). Адрес — «.documents»:
             «.files» занят FileProvider ниже (поделиться файлом); общий адрес у двух поставщиков ронял приложение. -->
        <provider
            android:name=".files.AppFilesProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <service
            android:name=".media.MusicCacheService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".media.MusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Фоновая проверка сообщений и отправка очереди (sync/MessageSyncScheduler.kt). Запускает только система. -->
        <service
            android:name=".sync.MessageSyncService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Страховка фоновой проверки: будильник, если система надолго отложила задание (sync/SyncAlarm.kt). -->
        <!-- 4.17: будильник отложенной отправки — ставит срочную отправку в назначенное время. -->
        <receiver
            android:name=".sync.ScheduledSendAlarm"
            android:exported="false" />

        <receiver
            android:name=".sync.SyncAlarm"
            android:exported="false" />

        <!-- «Прочитано» в уведомлении о сообщении (4.35): только своё уведомление (PendingIntent), чужим недоступен. -->
        <receiver
            android:name=".sync.MarkReadReceiver"
            android:exported="false" />

        <!-- «Ответить» в уведомлении (4.36): ответ — в очередь неотправленных. -->
        <receiver
            android:name=".sync.ReplyReceiver"
            android:exported="false" />

        <!-- Выдаёт чужим приложениям (почта, мессенджер) временный доступ на чтение к файлу, которым делятся. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
