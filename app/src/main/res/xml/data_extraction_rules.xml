<?xml version="1.0" encoding="utf-8"?>
<!--
  Что уходит из телефона при резервном копировании и переносе на новый телефон (4.28; Android 12+).

  android:allowBackup="false" в манифесте на Android 12+ выключает только копию в облако: перенос «телефон → телефон»
  (при настройке нового телефона, кабелем или по Wi-Fi) он не останавливает. Без этих правил на новый телефон
  переезжали вход в VK (cookies WebView), сохранённые переписки, черновики, журнал и собранные данные страниц.

  Теперь при переносе едут только настройки приложения (тема, меню, «свои экраны» — файл настроек по умолчанию,
  имя = applicationId + "_preferences"): на новом телефоне всё настроено, но вход в VK — заново. Черновики, папки,
  свой профиль, отметки фоновой работы лежат в других файлах и не едут. Копия в облако — ничего.
  Проверяется тестом BackupRulesTest (имя файла настроек сверяется с applicationId из build.gradle.kts).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="io.github.deadarhimag.vkweblite_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
