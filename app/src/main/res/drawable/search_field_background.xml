<?xml version="1.0" encoding="utf-8"?>
<!-- Поле поиска в панели сообщений (по диалогам и в переписке; 4.31): «пилюля» цветом поля, как поиск друзей и сообществ
     (panel_people.xml) и поле ввода, а не подчёркивание AppCompat с акцентом — оно выглядело чужим во всех темах. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="8dp"
    android:insetBottom="8dp">
    <shape android:shape="rectangle">
        <solid android:color="?attr/colorSurfaceContainerHigh" />
        <corners android:radius="20dp" />
        <padding android:left="12dp" android:right="4dp" />
    </shape>
</inset>
