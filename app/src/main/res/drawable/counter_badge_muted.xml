<?xml version="1.0" encoding="utf-8"?>
<!-- Счётчик непрочитанных у беседы с выключенными уведомлениями: приглушённый, как в VK.
     4.23: фон — цвет приглушённого текста (было colorOutline). Цифры цветом поверхности на colorOutline читались плохо
     (2,6:1 в тёмной теме, 3,1:1 в светлой); теперь не меньше 5,8:1, а счётчик по-прежнему серый, не синий. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="?attr/colorOnSurfaceVariant" />
    <!-- 4.27: «пилюля» при любой высоте (крупный шрифт): радиус больше половины высоты Android урезает до половины. -->
    <corners android:radius="100dp" />
</shape>
