<?xml version="1.0" encoding="utf-8"?>
<!--
  Телефон: меню выезжает слева (NavigationView внутри DrawerLayout).
  Широкий экран: NavigationController переносит меню в permanent_nav_container.
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 4.50: содержимое и под ним нижняя панель разделов (видна, когда у Android жест «Назад» от края — NavigationController). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 4.58: средняя ширина (600–840dp, меню не закреплено) — полоса значков слева: разделы и «Ещё»
             (NavigationController, NavStyle.RAIL). -->
        <com.google.android.material.navigationrail.NavigationRailView
            android:id="@+id/main_rail"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:labelVisibilityMode="labeled"
            app:menuGravity="center" />

        <FrameLayout
            android:id="@+id/permanent_nav_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <View
            android:id="@+id/permanent_nav_divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="?attr/colorOutlineVariant"
            android:visibility="gone" />

        <!-- Отступы от панели навигации и клавиатуры задаёт ui/SystemBars.kt; фон — под панелью навигации. -->
        <LinearLayout
            android:id="@+id/main_column"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/colorBackground"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorSurface"
                app:buttonGravity="center_vertical"
                app:menu="@menu/main_toolbar"
                app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <WebView
                    android:id="@+id/web_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Свои экраны поверх страниц: музыка, друзья и сообщества, страницы людей и сообществ. -->
                <include layout="@layout/panel_music" />

                <include layout="@layout/panel_people" />

                <include layout="@layout/panel_photos" />

                <include layout="@layout/panel_owner" />

                <include layout="@layout/panel_video" />

                <include layout="@layout/panel_clips" />

                <!-- Индикатор загрузки на границе панели и страницы. -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/page_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:max="100"
                    android:visibility="gone"
                    app:trackColor="@android:color/transparent"
                    app:trackThickness="@dimen/progress_thickness" />

                <!-- Страница не загрузилась (4.51: оформление общее с пустыми экранами — ui/EmptyState.kt,
                     кнопки «Повторить» и «Сохранённая копия» — ui/LoadErrorScreen.kt). -->
                <FrameLayout
                    android:id="@+id/error_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?android:attr/colorBackground"
                    android:padding="@dimen/content_padding"
                    android:visibility="gone">

                    <include
                        layout="@layout/view_empty_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center" />
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/main_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:labelVisibilityMode="labeled" />
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="@dimen/nav_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorSurface"
        app:headerLayout="@layout/nav_header" />
</androidx.drawerlayout.widget.DrawerLayout>
