<?xml version="1.0" encoding="utf-8"?>
<!-- Чужое сообщение: слева, на сером; в беседах сверху имя автора, слева — аватар у последнего сообщения «реплики»
     (4.53; у остальных — пустое место той же ширины, в личной переписке места нет — ChatDays.avatarSlot).
     Отступ 56dp с противоположной стороны ограничивает ширину пузыря и разводит стороны. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="bottom"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="56dp"
    android:paddingVertical="2dp">

    <!-- Подпись (имя автора) ставит ChatAdapter. -->
    <ImageView
        android:id="@+id/message_avatar"
        tools:ignore="ContentDescription"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:visibility="gone" />

    <com.example.vkweb.ui.MaxWidthLinearLayout
        android:id="@+id/bubble"
        android:layout_width="wrap_content"
        android:maxWidth="@dimen/bubble_max_width"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@drawable/bubble_in"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/message_sender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone" />

        <!-- Ответ на сообщение: цитата (автор и начало текста); нажатие ведёт к тому сообщению. -->
        <LinearLayout
            android:id="@+id/message_reply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <View
                android:id="@+id/message_reply_bar"
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:background="?attr/colorPrimary"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/message_reply_sender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/message_reply_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="?attr/textAppearanceBodySmall" />
            </LinearLayout>
        </LinearLayout>


        <!-- Фото из вложений: заполняется в ChatAdapter. -->
        <LinearLayout
            android:id="@+id/message_photos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- Видео из вложений: карточки, заполняются в ChatAdapter; нажатие открывает видео. -->
        <LinearLayout
            android:id="@+id/message_videos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- Голосовые сообщения: проигрыватели, заполняются в ChatAdapter. -->
        <LinearLayout
            android:id="@+id/message_voices"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- Ссылки, файлы, записи, клипы: карточки, заполняются в ChatAdapter. -->
        <LinearLayout
            android:id="@+id/message_cards"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/message_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface"
            android:textColorLink="?attr/colorPrimary"
            android:textIsSelectable="false" />

        <!-- Пересланные сообщения: блоки «Переслано» под текстом, заполняются в ChatAdapter. -->
        <LinearLayout
            android:id="@+id/message_forwards"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- Реакции (4.61): картинка VK и число; своя — с обводкой; нажатие — поставить или снять (ChatAdapter). -->
        <LinearLayout
            android:id="@+id/message_reactions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/message_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </com.example.vkweb.ui.MaxWidthLinearLayout>
</LinearLayout>
