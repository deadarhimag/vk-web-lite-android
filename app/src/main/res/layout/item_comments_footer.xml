<?xml version="1.0" encoding="utf-8"?>
<!--
  Состояние комментариев под записью на её экране (5.00.19): загрузка, не загрузились, пусто. Внутри списка, а не поверх
  него, чтобы не закрывать запись. Пусто - один значок комментария без текста.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/comments_footer_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_post_comment"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/comments_footer_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
