<?xml version="1.0" encoding="utf-8"?>
<!--
  Свой экран музыки поверх страницы (страница под ним играет звук): сверху поиск (4.79) и переключатель
  «Музыка / Плейлисты», ниже — «Мои треки», список плейлистов, треки открытого плейлиста (с кнопкой «к плейлистам»)
  или результаты поиска (с кнопкой «назад» в строке поиска).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/music_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Поиск музыки (4.79): поиск самой страницы VK, результаты — своим списком (ui/MusicPanel.kt). -->
        <LinearLayout
            android:id="@+id/music_search_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/music_search_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/music_search_back"
                android:src="@drawable/ic_arrow_back"
                android:visibility="gone" />

            <!-- Вид поля — как поиск друзей и сообществ (layout/panel_people.xml). -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.FilledBox.Dense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:boxBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:boxCornerRadiusBottomEnd="20dp"
                app:boxCornerRadiusBottomStart="20dp"
                app:boxCornerRadiusTopEnd="20dp"
                app:boxCornerRadiusTopStart="20dp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:endIconMode="clear_text"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_search">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/music_search_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/music_search_hint"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:inputType="text|textNoSuggestions"
                    android:maxLines="1"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Поиск по исполнителю: в списке только его треки (можно выключить — показать всё, что нашёл VK). -->
        <com.google.android.material.chip.Chip
            android:id="@+id/music_search_artist_only"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:checkable="true"
            android:checked="true"
            android:ellipsize="end"
            android:maxWidth="320dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/music_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/music_switch_music"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/music_section_music" />

            <Button
                android:id="@+id/music_switch_playlists"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/music_section_playlists" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Открытый плейлист: назад к списку плейлистов и название. -->
        <LinearLayout
            android:id="@+id/music_playlist_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="16dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/music_playlist_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/playlist_back"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/music_playlist_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <!-- «Добавить к себе» (4.45): только у чужого плейлиста, который ещё не добавлен. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/music_playlist_follow"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="@string/music_follow_playlist"
                android:visibility="gone"
                app:icon="@drawable/ic_add" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/music_save_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurfaceContainerHigh"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/music_save_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/music_save_stop"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:minWidth="0dp"
                    android:text="@string/music_save_stop_short" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/music_save_details"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:minWidth="0dp"
                    android:text="@string/music_save_remaining" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/music_save_dismiss"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:minWidth="0dp"
                    android:text="@string/close" />
            </LinearLayout>
        </LinearLayout>

        <!-- Обновление потягиванием (4.52): ui/PullRefresh.kt, свежее просит overlay/PageOverlay.kt. -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/panel_refresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/music_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="72dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/playlists_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="72dp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/playlist_tracks_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="72dp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/music_search_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="72dp"
                    android:visibility="gone" />

                <!-- Первая загрузка (4.56): силуэты строк вместо крутилки — ui/SkeletonView.kt. -->
                <com.example.vkweb.ui.SkeletonView
                    android:id="@+id/panel_skeleton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:tag="square"
                    android:visibility="gone" />
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <include layout="@layout/panel_chrome" />

    <!-- Мини-плеер: что играет; нажатие открывает плеер с перемоткой (ui/PlayerSheet.kt). -->
    <LinearLayout
        android:id="@+id/music_player_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurfaceContainerHigh"
        android:clickable="true"
        android:contentDescription="@string/player_open"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/music_player_cover"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/music_player_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/music_player_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/music_player_toggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_play"
            android:src="@drawable/ic_player_play" />
    </LinearLayout>
</FrameLayout>
