<?xml version="1.0" encoding="utf-8"?>
<!-- То же боковое меню, что на главном экране: выезжает слева, на широком экране может быть закреплено. -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/messages_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 4.50: содержимое и под ним нижняя панель разделов (видна, когда у Android жест «Назад» от края — NavigationController). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 4.58: средняя ширина (600–840dp, меню не закреплено) — полоса значков слева: разделы и «Ещё»
             (NavigationController, NavStyle.RAIL). -->
        <com.google.android.material.navigationrail.NavigationRailView
            android:id="@+id/messages_rail"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:labelVisibilityMode="labeled"
            app:menuGravity="center" />

        <FrameLayout
            android:id="@+id/messages_permanent_nav"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <View
            android:id="@+id/messages_permanent_divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="?attr/colorOutlineVariant"
            android:visibility="gone" />

        <!--
          Две колонки на широком экране (3.94): слева список диалогов, справа переписка. Список, папки и пустой текст
          переносит сюда messages/MessagesPanes.kt; на узком экране колонки нет.
        -->
        <LinearLayout
            android:id="@+id/messages_dialogs_pane"
            android:layout_width="@dimen/messages_pane_width"
            android:layout_height="match_parent"
            android:background="?attr/colorSurface"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/messages_dialogs_pane_title"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="@string/tab_messages"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnSurface" />

            <FrameLayout
                android:id="@+id/messages_dialogs_pane_frame"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <View
            android:id="@+id/messages_dialogs_pane_divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="?attr/colorOutlineVariant"
            android:visibility="gone" />

<!-- Отступы от панели навигации и клавиатуры (поле ввода над ней) задаёт ui/SystemBars.kt. -->
<LinearLayout
    android:id="@+id/messages_column"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/messages_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:buttonGravity="center_vertical"
        android:background="?attr/colorSurface"
        app:menu="@menu/messages_toolbar"
        app:navigationContentDescription="@string/navigate_back"
        app:title="@string/tab_messages"
        app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

    <LinearLayout
        android:id="@+id/messages_web_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerHigh"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/messages_web_mode_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="8dp"
            android:text="@string/web_mode_active"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:accessibilityLiveRegion="polite" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/messages_web_mode_retry"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/web_mode_retry" />
    </LinearLayout>

    <!-- Папки мессенджера (3.79): «Все», «Непрочитанные», «Каналы», «Бизнес» и свои папки VK — фильтр списка диалогов. -->
    <HorizontalScrollView
        android:id="@+id/dialogs_folders_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:scrollbars="none"
        android:visibility="gone">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/dialogs_folders"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingBottom="8dp"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Страница VK: в режиме чтения невидима (но с размером), при сбое показывается как есть. -->
        <WebView
            android:id="@+id/reader_web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible" />

        <!-- Обновление потягиванием (4.52). Рамка видна всегда, а жест — только когда виден список (ui/PullRefresh.kt); в двух колонках рамка переезжает вместе со списком (MessagesPanes). -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/dialogs_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/dialogs_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp"
                    android:visibility="gone" />

                <!-- Первая загрузка (4.56): силуэты строк вместо крутилки — ui/SkeletonView.kt. -->
                <com.example.vkweb.ui.SkeletonView
                    android:id="@+id/dialogs_skeleton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:visibility="gone" />

        <!-- «Вниз» (3.94): переписка прокручена вверх — кнопка к последнему сообщению и число новых, пришедших за это время. -->
        <FrameLayout
            android:id="@+id/chat_scroll_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/chat_scroll_down_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/chat_scroll_down"
                android:src="@drawable/ic_arrow_down"
                app:backgroundTint="?attr/colorSurfaceContainerHigh"
                app:fabSize="mini"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/chat_scroll_down_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/counter_badge"
                android:elevation="8dp"
                android:importantForAccessibility="no"
                android:minHeight="20dp"
                android:minWidth="20dp"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnPrimary"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Две колонки, переписка не выбрана (3.94). -->
        <TextView
            android:id="@+id/chat_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/chat_placeholder"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/messages_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/content_padding"
            android:visibility="gone">

            <!-- 4.51: пусто, ничего не найдено, пустая папка — значок, заголовок и кнопка (ui/EmptyState.kt). -->
            <include
                layout="@layout/view_empty_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/messages_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:indeterminate="true"
            android:visibility="gone"
            app:showDelay="@integer/progress_show_delay_ms"
            app:trackThickness="@dimen/progress_thickness" />
        <!-- Плашка «нет сети» / «обновить не удалось»: поверх списка, чтобы не сдвигать его. -->
        <TextView
            android:id="@+id/messages_offline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="16dp"
            android:background="@drawable/offline_pill"
            android:elevation="4dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceInverse"
            android:text="@string/offline_banner"
            android:visibility="gone" />

    </FrameLayout>

    <!--
      Музыка из переписки (3.60) — как плеер раздела «Музыка»: обложка, название и исполнитель, перемотка, «назад»,
      пауза, «вперёд» (очередь — треки этой переписки), закрыть. Когда трек нажимает сама страница (запасной путь),
      перемотка и «назад/вперёд» скрыты.
    -->
    <LinearLayout
        android:id="@+id/chat_audio_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerHigh"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/chat_audio_cover"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/chat_audio_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/chat_audio_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/chat_audio_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Скорость голосовых (4.0): 1× → 1,5× → 2×; у музыки кнопки нет. -->
            <TextView
                android:id="@+id/chat_audio_speed"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:minWidth="48dp"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/chat_audio_stop"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chat_audio_stop"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/chat_audio_prev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_previous"
                android:src="@drawable/ic_player_prev" />

            <ImageButton
                android:id="@+id/chat_audio_toggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/voice_pause"
                android:src="@drawable/ic_player_pause" />

            <ImageButton
                android:id="@+id/chat_audio_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_next"
                android:src="@drawable/ic_player_next" />

            <SeekBar
                android:id="@+id/chat_audio_seek"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/player_seek"
                android:max="1000" />
        </LinearLayout>
    </LinearLayout>

    <!-- Ответ на сообщение: на что отвечаем (нажатие — к нему), отменить ответ. -->
    <LinearLayout
        android:id="@+id/compose_reply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <View
            android:layout_width="2dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/colorPrimary"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/compose_reply_quote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/compose_reply_sender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorPrimary" />

            <TextView
                android:id="@+id/compose_reply_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/compose_reply_cancel"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reply_cancel"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Подсказки стикеров по набранному слову (3.92): «привет» — стикеры с приветствием; нажатие — отправить. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sticker_suggest"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="?attr/colorSurface"
        android:clipToPadding="false"
        android:paddingHorizontal="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/attachment_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerHigh"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/attachment_status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:accessibilityLiveRegion="polite" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/attachment_status_cancel"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/cancel" />
    </LinearLayout>

    <!-- Выбранные для отправки файлы; нажатие на файл убирает его. -->
    <HorizontalScrollView
        android:id="@+id/attachments_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:paddingHorizontal="8dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/attachments_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/compose_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/compose_attach"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/compose_attach"
            android:src="@drawable/ic_attach" />

        <EditText
            android:id="@+id/compose_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/lite_compose_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant" />

        <!-- Идёт запись голосового (4.59): вместо поля ввода — точка, время и подсказка об отмене. -->
        <LinearLayout
            android:id="@+id/compose_recording"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:visibility="gone">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/recording_dot" />

            <TextView
                android:id="@+id/compose_recording_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/compose_recording_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/voice_record_cancel_hint"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Стикеры (3.73): недавние стикеры страницы, отправка нажатием. -->
        <ImageButton
            android:id="@+id/compose_sticker"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/compose_stickers"
            android:src="@drawable/ic_sticker" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/compose_send"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/lite_send"
            app:icon="@drawable/ic_send"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

        <!-- Голосовое (4.59, Android 10+): на месте «Отправить», пока поле пустое; удерживать — запись, отпустить —
             отправить, смахнуть влево — отмена (messages/VoiceComposer.kt). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/compose_mic"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/voice_record"
            android:visibility="gone"
            app:icon="@drawable/ic_mic"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />
    </LinearLayout>
</LinearLayout>
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/messages_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:labelVisibilityMode="labeled" />
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/messages_nav"
        android:layout_width="@dimen/nav_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorSurface"
        app:headerLayout="@layout/nav_header" />
</androidx.drawerlayout.widget.DrawerLayout>
